# Puerto del servidor (Render/Railway lo asignan automáticamente)
PORT=3000

# Carpeta de datos en servidor (opcional; ej. /var/data en disco persistente)
# DATA_DIR=

# Días antes del descanso para alertar (0 = hoy, 5 = hasta 5 días antes)
DIAS_ALERTA=5

# Hora del aviso diario (formato cron: minuto hora * * *)
# Ejemplo: todos los días a las 08:00
CRON_AVISOS=0 8 * * *

# Zona horaria para el cron (ej. America/Argentina/Buenos_Aires)
TZ=America/Argentina/Buenos_Aires

# Correo remitente
MAIL_FROM="Descansos Choferes <notificaciones@tuempresa.com>"

# SMTP (Gmail, Outlook, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# Clave para ejecutar avisos manualmente (opcional)
ADMIN_KEY=cambiar-esta-clave-secreta
